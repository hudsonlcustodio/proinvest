{
  "name": "proinvest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/golden/equity-holding.test.js dist/tests/golden/equity-pair.test.js dist/tests/golden/futures-round-trip.test.js dist/tests/golden/crypto-spot.test.js dist/tests/integration/equity-holding-db.test.js",
    "start:api": "node dist/apps/api/src/server.js",
    "dev:api": "node --watch --experimental-strip-types apps/api/src/server.ts",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "test:unit": "npm run build && node --test dist/tests/golden/**/*.test.js",
    "test:integration": "npm run build && node --test dist/tests/integration/**/*.test.js"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "express": "5.2.1",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "typescript": "6.0.3"
  }
}
